# stock-limit-up-analyzer — 环境变量样例
#
# 用法：复制为 `.env` 后填入真实值。`.env` 已被 .gitignore 忽略（`*.env` 规则）；
#      本文件（`.env.example`）**只放占位符，禁止写入任何真实凭据**。
#
# 🔴 纪律：
#   - Secret 只经环境变量注入 ⇒ 不进 Git、不进前端 bundle、不发给浏览器；
#   - 不要把生产凭据写进测试 fixture（测试用内存替身，见
#     `server/artifactStorage/inMemoryArtifactStorage.ts`）。

# ---- 数据库（TiDB Cloud；实验 Run 元数据也存这里） ----
# 形如 mysql://user:pass@host:4000/dbname?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# ---- 会话 / 认证 ----
JWT_SECRET=
OAUTH_SERVER_URL=

# ---- 行情数据源（Tushare；积分受限，见项目细则） ----
TUSHARE_TOKEN=

# ---- 服务端口 ----
PORT=3000

# ---- 对象存储：MinIO（RESEARCH-EXPERIMENT-004 · 实验 Run 的 Result / Manifest / 产物） ----
#
# 用途：独立研究实验的**大产物**（result.json / manifest.json / CSV / Parquet / Chart / 日志）
#      落在对象存储；TiDB 只存 Run 元数据与 Manifest 引用。
#
# 🔴 未配置时：实验仍可执行，但结果**无法持久化** ⇒ 该次 Run 会被记为 FAILED
#    （规格 §13：绝不允许「DB = COMPLETED 但对象不存在」）。
#    这是刻意的：不做静默降级到本地磁盘，否则「其实没接对象存储」会被误当成「跑成功了」。
#
# MinIO 是 S3 兼容协议 ⇒ 本适配器用已装的 @aws-sdk/client-s3（forcePathStyle=true）。
# 桶需要**事先存在**（本任务不负责创建桶 / 部署 MinIO 集群）。
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=research
# 凭据：优先用 MINIO_ACCESS_KEY / MINIO_SECRET_KEY；也兼容历史命名 MINIO_USERNAME / MINIO_PASSWORD。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---- 可选：连接池 / 诊断 ----
# DB_POOL_SIZE=10
